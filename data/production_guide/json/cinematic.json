  "bus_insert_note": "Cinematic: NO bus saturation anywhere. THD is a proximity cue; orchestral depth staging requires far layers below 1% THD.",
  "sidechain_routing": [
    {"trigger": "Kick/Taiko",   "target": "Bass",        "ratio": "2:1", "attack_ms": 10, "release_formula": "60000/BPM",  "gr_db": 2, "note": "Minimal ducking preserves 18 LU dynamic range."},
    {"trigger": "Impacts (FX)", "target": "Synth bus",   "ratio": "3:1", "attack_ms": 5,  "release_formula": "120000/BPM", "gr_db": 4, "note": "Long release matches impact's own 1-2 s decay."},
    {"trigger": "Melody",       "target": "Pads",        "ratio": "2:1", "attack_ms": 20, "release_formula": "120000/BPM", "gr_db": 3, "note": "20 ms attack tracks bowed onsets."},
    {"trigger": "Dialogue stem","target": "All music buses","ratio": "4:1","attack_ms": 15,"release_formula": "120000/BPM", "gr_db": "6-9","note": "Music sits 6-9 LU under dialogue per R128 convention."}

  "bus_inserts": {
    "drum":   {"chain": "EQ -> Comp (no saturation, no limiter)", "comp_ratio": "2:1", "comp_threshold_dbfs": -20, "comp_gr_db": 2, "comp_release_formula": "30000/BPM", "note": "No bus saturation: THD collapses depth ladder. No clipper: transient punch is the deliverable."},

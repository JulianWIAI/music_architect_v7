  "bus_inserts": {
    "drum":   {"chain": "Saturation -> EQ -> Comp -> Clipper", "comp_ratio": "4:1", "comp_threshold_dbfs": -14, "comp_gr_db": 4, "comp_release_formula": "15000/BPM"},
    "bass":   {"chain": "EQ -> Saturation -> Comp",            "comp_ratio": "4:1", "comp_threshold_dbfs": -16, "comp_gr_db": 4, "comp_release_formula": "30000/BPM"},
    "synth":  {"chain": "EQ -> Comp -> Filter (LPF 9 kHz)",   "comp_ratio": "2:1", "comp_threshold_dbfs": -20, "comp_gr_db": 2, "comp_release_formula": "60000/BPM"},
    "fx":     {"chain": "Filter -> Comp (duck) -> Limiter",    "comp_ratio": "4:1"},
    "master": {"chain": "EQ -> Glue Comp -> Clipper -> Limiter","comp_ratio": "2:1", "comp_threshold_dbfs": -20, "comp_gr_db": 2, "comp_release_formula": "auto"}
  },
  "bus_insert_note": "Hip-Hop: Saturation FIRST on drum bus (raises RMS before compressor, reducing needed GR). Clipper before limiter removes crest factor with no time constant.",
  "sidechain_routing": [
    {"trigger": "Kick",       "target": "Bass/808",        "ratio": "6:1",   "attack_ms": 0.5, "release_formula": "30000/BPM", "gr_db": "6-8"},
    {"trigger": "Kick",       "target": "Pads",            "ratio": "4:1",   "attack_ms": 3,   "release_formula": "30000/BPM", "gr_db": 5},
    {"trigger": "Kick",       "target": "Everything else", "ratio": "2:1",   "attack_ms": 10,  "release_formula": "15000/BPM", "gr_db": 1.5},
    {"trigger": "Snare/Clap", "target": "Bass",            "ratio": "3:1",   "attack_ms": 1,   "release_formula": "7500/BPM",  "gr_db": 2},
    {"trigger": "Melody",     "target": "Synth bus",       "ratio": "3:1",   "attack_ms": 5,   "release_formula": "60000/BPM", "gr_db": 3}
  ],
  "parallel_compression": {
    "wet_blend_pct": "40-60 (target 50)",
    "ratio": "20:1 (or infinity:1)",
    "threshold_dbfs": -34,
    "gr_wet_db": "15-20",
    "attack_ms": 1,
    "release_formula": "7500/BPM",
    "wet_path_hpf_hz": 90,
    "wet_path_lpf_hz": 8000,
    "net_level_rise_db": 3.5,
    "cf_reduction_db": "4-6",
    "lra_target_lu": "3-6",
    "reasoning": "50% wet is the genre signature: with a ~706 ms beat the gaps between hits are long; sustained wet path fills them, raising LUFS-S by 3-4 dB with no peak increase."
  },
  "transient_shaping": {
    "kick":     {"attack_db": 2,  "sustain_db": 3,  "note": "Sustain lengthened to carry the 808 relationship"},
    "snare":    {"attack_db": 6,  "sustain_db": -5, "note": "Tail removed so 1/16 grid stays legible at 176.5 ms"},
    "bass":     {"attack_db": 2,  "sustain_db": 0}
  },
